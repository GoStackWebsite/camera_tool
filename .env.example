# Camera connection
RTSP_URL=rtsp://10.0.0.93:554/streaming/channels/1501
RTSP_USER=
RTSP_PASS=

# Detection
MODEL=yolo11m.pt          # yolo11s (faster) / yolo11m (default, best for seated/occluded people)
DEVICE=auto               # auto | cpu | 0 (first CUDA GPU)
CONF=0.35                 # min detection confidence
IMGSZ=640                 # inference size (multiple of 32)
TARGET_FPS=15             # max analysis frames per second

# Server
HOST=0.0.0.0
PORT=8000
JPEG_QUALITY=80
STREAM_WIDTH=1280         # downscale browser stream to this width (0 = native)
