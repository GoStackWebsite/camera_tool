.venv/
__pycache__/
*.pyc
.env
data/*.db
data/*.db-journal
data/snapshots/
*.pt
install_*.log
models/*.zip
data/*.bak

# runtime logs (python main.py / pythonw / tools\stack.ps1)
logs/
# cached Congruence Eye configuration (managed mode)
data/congruence_remote.json
# local configuration with the edge API key and camera credentials (never commit)
data/config.json
data/config.json.bak
data/config.pre-managed.json
data/mcp.json
data/e2e_state.json
data/*.db-wal
data/*.db-shm
data/*.jpg
# downloaded ONNX models (fetched by app/demographics.py on first run)
models/*.onnx

# packaged source archives
dist/

# training data and runs (large, store specific)
datasets/staff/
runs/
yolo11n-cls.pt

# the portable staff-uniform model is versioned on purpose (small; reused by other stores)
!models/staff_cls.pt

# POS drop folder and evidence clips (runtime data)
data/pos_inbox/
data/clips/
datasets/*.mp4

# person crops used for training (never commit images of people)
datasets/brand/
datasets/*.cache
# the portable brand model travels with the staff model
!models/brand_cls.pt

# shared camera regions of this site (store fusion); an example is in docs/fusion.example.json
data/fusion.json

# live-view captures kept as evidence (people in the shop): local only
docs/proof/
